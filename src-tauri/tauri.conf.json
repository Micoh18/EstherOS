{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Estheros",
  "version": "1.0.0",
  "identifier": "com.estheros.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Estheros",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Estheros",
    "copyright": "© 2026 Estheros",
    "license": "LicenseRef-Proprietary",
    "category": "Productivity",
    "shortDescription": "Calendario, diario y tareas con estética cozy",
    "longDescription": "Estheros es un espacio personal y tranquilo para organizar el día: calendario, diario y lista de tareas, con todos los datos guardados solo en tu equipo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
